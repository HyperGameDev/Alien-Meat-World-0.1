[sub_resource type="Shader" id="Shader_82sq5"]
code = "shader_type spatial;
render_mode depth_prepass_alpha, specular_schlick_ggx, ensure_correct_normals, shadows_disabled, ambient_light_disabled;

uniform sampler2D tex_frg_32;
uniform sampler2D tex_frg_3;
uniform vec4 MainColor : source_color;
uniform vec4 BackColor1 : source_color;
uniform vec4 BackColor2 : source_color;
uniform float Brightness;

// Additional Parameters
uniform float SineFrequency : hint_range(0.0, 100.0);
uniform float SineAmplitude : hint_range(0.0, 1.0);
uniform float CosFrequency : hint_range(0.0, 10.0);
uniform float CosAmplitude : hint_range(0.0, 1.0);
uniform float UVScaleX : hint_range(0.0, 10.0);
uniform float UVScaleY : hint_range(0.0, 10.0);
uniform vec3 ScreenUVOffset : source_color;
uniform float ScreenUVScaleX : hint_range(0.0, 10.0);
uniform float ScreenUVScaleY : hint_range(0.0, 10.0);
uniform float ScreenUVScaleZ : hint_range(0.0, 10.0);
uniform vec3 FinalColorMix : source_color;

uniform sampler2D SCREEN_TEXTURE : hint_screen_texture, filter_linear_mipmap;

void fragment() {
    vec3 uv = vec3(UV.x * UVScaleX, UV.y * UVScaleY, 0.0);
    float smooth_y = smoothstep(0.0, 0.2, uv.y);
    
    vec3 offset = uv + vec3(-0.2 * TIME, -0.3 * TIME, 0.0);
    vec3 scale = vec3(1.0, 4.0, 1.0);
    vec3 tex_color = texture(tex_frg_32, (offset * scale).xy).rgb;
    float alpha = clamp(smooth_y - dot(tex_color, vec3(0.333)), 0.0, 1.0) + uv.y;

    vec3 screen_uv = vec3(SCREEN_UV.x * ScreenUVScaleX, SCREEN_UV.y * ScreenUVScaleY, 0.0) + ScreenUVOffset;
    vec3 tex_color2 = texture(tex_frg_3, offset.xy).rgb;
    vec3 final_color = tex_color * tex_color2 * smoothstep(0.2, 0.8, uv.y);

    float fresnel = pow(1.0 - clamp(dot(NORMAL, VIEW), 0.0, 1.0), 1.0);
    vec3 mixed_color = mix(screen_uv + fresnel * NORMAL, final_color, Brightness);

    vec3 color_mix = mix(MainColor.rgb, mix(BackColor1.rgb, BackColor2.rgb, (sin(TIME) + 1.0) / 2.0), uv.y);
    final_color = mix(color_mix, FinalColorMix, dot(tex_color, vec3(0.333)) * smoothstep(1.0, 0.0, uv.y));

    ALPHA = alpha;
    EMISSION = mixed_color;
}

void light() {
    // Empty light function
}
"


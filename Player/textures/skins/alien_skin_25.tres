shader_parameter/pulsation_amplitude = 0.693
shader_parameter/pulsation_offset = 0.941
shader_parameter/uv1_scale = Vector3(14.14, 14.14, 14.14)
shader_parameter/uv1_offset = Vector3(6.29, -0.08, 0)
shader_parameter/uv2_scale = Vector3(1, 1, 1)
shader_parameter/uv2_offset = Vector3(0, 0, 0)

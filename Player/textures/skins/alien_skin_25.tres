[sub_resource type="Shader" id="Shader_fye7u"]
code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_burley, specular_schlick_ggx;

uniform vec4 albedo : source_color;
uniform sampler2D texture_albedo : source_color, filter_linear_mipmap, repeat_enable;
uniform float point_size : hint_range(0.1, 128.0, 0.1);

uniform float roughness : hint_range(0.0, 1.0);
uniform sampler2D texture_metallic : hint_default_white, filter_linear_mipmap, repeat_enable;
uniform vec4 metallic_texture_channel;
uniform sampler2D texture_roughness : hint_roughness_r, filter_linear_mipmap, repeat_enable;

uniform float specular : hint_range(0.0, 1.0, 0.01);
uniform float metallic : hint_range(0.0, 1.0, 0.01);

uniform sampler2D texture_emission : source_color, hint_default_black, filter_linear_mipmap, repeat_enable;
uniform vec4 emission : source_color;
uniform float emission_energy : hint_range(0.0, 100.0, 0.01);

// New uniform parameters for noise adjustments
uniform float noise_factor1 : hint_range(0.0, 500.0) = 1.0;
uniform float noise_factor3 : hint_range(0.0, 500.0) = 10000.0;
uniform float noise_intensity : hint_range(0.0, 2.0, 0.01) = 1.0;

uniform float time_multiplier : hint_range(.001,1.) = 2.0;
uniform float pulsation_speed : hint_range(0.0, 50.0) = 1.0; // Adjustable pulsation speed
uniform float pulsation_amplitude : hint_range(0.0, 1.0) = 0.5; // Amplitude for pulsation adjustment
uniform float pulsation_offset : hint_range(0.0, 1.0) = 0.5; // Offset for pulsation adjustment

uniform vec3 uv1_scale;
uniform vec3 uv1_offset;
uniform vec3 uv2_scale;
uniform vec3 uv2_offset;

// Simple noise function with adjustable parameters
float rand(vec2 co) {
    return fract(sin(dot(co.xy, vec2(noise_factor1, 1.0))) * noise_factor3);
}

void vertex() {
    UV = UV * uv1_scale.xy + uv1_offset.xy;
}

void fragment() {
    vec2 base_uv = UV;

    vec4 albedo_tex = texture(texture_albedo, base_uv);
    ALBEDO = albedo.rgb * albedo_tex.rgb;

    float metallic_tex = dot(texture(texture_metallic, base_uv), metallic_texture_channel);
    METALLIC = metallic_tex * metallic;
    SPECULAR = specular;

    vec4 roughness_texture_channel = vec4(1.0, 0.0, 0.0, 0.0);
    float roughness_tex = dot(texture(texture_roughness, base_uv), roughness_texture_channel);
    ROUGHNESS = roughness_tex * roughness;

    // Emission: Enabled
    vec3 emission_tex = texture(texture_emission, base_uv).rgb;
    // Add flicker effect with noise and time
    float noise = rand(vec2(TIME * time_multiplier, 0.0)) * noise_intensity;
    float pulsating_emission_energy = emission_energy * (pulsation_offset + pulsation_amplitude * sin(TIME * pulsation_speed)) * noise;
    // Emission Operator: Add
    EMISSION = (emission.rgb + emission_tex) * pulsating_emission_energy;
}
"

[resource]
render_priority = 0
next_pass = ExtResource("1_tmtlk")
shader = SubResource("Shader_fye7u")
shader_parameter/albedo = Color(1, 1, 1, 1)
